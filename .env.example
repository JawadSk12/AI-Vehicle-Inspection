# CAPVIA AI Environment Variables
APP_NAME=CAPVIA AI
APP_ENV=development
DEBUG=true
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=capvia_ai
POSTGRES_USER=capvia
POSTGRES_PASSWORD=capvia_secure_password
DATABASE_URL=postgresql+asyncpg://capvia:capvia_secure_password@postgres:5432/capvia_ai
MODEL_PATH=ai_model/weights/best_rtdetr.pt
MODEL_CONFIDENCE=0.25
MODEL_IOU_THRESHOLD=0.45
MODEL_IMG_SIZE=1024
USE_SAM=false
UPLOAD_DIR=storage/uploads
RESULT_DIR=storage/results
REPORT_DIR=storage/reports
MASK_DIR=storage/masks
MAX_UPLOAD_SIZE_MB=20
DEFAULT_SCALE_FACTOR=0.05
DEFAULT_IMAGE_DPI=96
CORS_ORIGINS=["http://localhost:3000","http://localhost"]
ONNX_MODEL_PATH=ai_model/weights/best.onnx
USE_ONNX=false
